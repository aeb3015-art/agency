# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Contact form delivery ----
# Provider: "resend" | "webhook" | "none"
#   resend  -> sends an email via the Resend HTTP API (https://resend.com)
#   webhook -> POSTs the JSON inquiry to any URL (CRM, Zapier, Make, n8n, Slack workflow...)
#   none    -> form validates but reports that delivery is not configured (honest failure state)
CONTACT_PROVIDER=none

# Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@example.com
CONTACT_FROM_EMAIL="Website <noreply@example.com>"

# Webhook
CONTACT_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header
CONTACT_WEBHOOK_SECRET=

# Rate limit: max submissions per IP per window (in-memory; per server instance)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
